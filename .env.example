# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
# Required by ingestion write guards: development, staging, or production.
# Keep empty until you have verified which database DATABASE_URL targets.
HACK0_DATABASE_ENV=
# Sync scripts are dry-run by default. Set this only when using --write.
HACK0_ALLOW_WRITES=false
# Production also requires this second, explicit confirmation.
HACK0_ALLOW_PRODUCTION_WRITES=false

# Trigger.dev (get yours at https://cloud.trigger.dev)
TRIGGER_PROJECT_ID=proj_...
TRIGGER_SECRET_KEY=tr_dev_...

# Firecrawl (for scraping)
FIRECRAWL_API_KEY=fc-...

# Resend (for emails)
RESEND_API_KEY=re_...

# UploadThing (for image uploads)
UPLOADTHING_TOKEN=...

# Google Fonts API
GOOGLE_FONTS_API_KEY=AIza...

# AI Gateway
AI_GATEWAY_API_KEY=vck_...

# Luma Integration (optional; requires Luma Plus)
LUMA_API_KEY=secret-...
# Multiple calendar keys are supported as comma-separated values.
LUMA_API_KEYS=secret-...,secret-...
# Calendar-scoped key used only to publish approved Hack0 events to the Hack0 calendar.
HACK0_LUMA_CALENDAR_API_KEY=secret-...
# Webhook signing secret(s), one per connected calendar.
LUMA_WEBHOOK_SECRET=whsec_...
LUMA_WEBHOOK_SECRETS=whsec_...,whsec_...
# Legacy only: old internal calendar sync used this. The current public API uses the calendar-scoped LUMA_API_KEY.
# HACK0_LUMA_CALENDAR_API_ID=cal-...
LUMA_CONNECTION_ENCRYPTION_KEY=generate-a-long-random-secret

# Admin Access (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# fal.ai
FAL_API_KEY=

# Scraper sources
PERPLEXITY_API_KEY=pplx-...
EXA_API_KEY=exa-...
